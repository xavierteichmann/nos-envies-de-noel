# Copie ce fichier sous le nom .env.local pour essayer sur ton ordinateur.
# En ligne, ces deux réglages se saisissent dans Vercel (Settings, Environment Variables).

# Le secret qui fabrique les liens personnels. Invente une longue suite de caractères,
# par exemple avec la commande :  openssl rand -hex 24
# Si tu le changes, tous les liens changent.
CLE_FAMILLE=remplace-moi-par-une-longue-suite-de-caracteres

# Les prénoms, séparés par des virgules, dans l'ordre d'affichage.
FAMILLE=Alice,Bernard,Chloé,David,Emma,Félix
